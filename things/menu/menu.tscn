bbcode_enabled = true
text = "[font_size=20][wave amp=5 freq=5]What can I do in this world. All i have is the fact that i can move [b][font_size=24][color=orange_red][pulse color=red][ W A S D ][/pulse][/color][/font_size][/b] and smoke this damn cigarette [b][font_size=24][color=orange_red][pulse color=red][ mouse wheel down ][/pulse][/color][/font_size][/b] otherwise i am going to die. This drains my energy but it seems my role in killing [b][font_size=24][color=orange_red][pulse color=red][ Left mouse click ][/pulse][/color][/font_size][/b] these orcs is giving me energy [b][font_size=24][color=orange_red][pulse color=red][ drpped orbs ][/pulse][/color][/font_size][/b]. With this time given to me even i can change the course of the future."
fit_content = true
visible_characters_behavior = 1

