bbcode_enabled = true
text = "[font_size=24][wave amp=5 freq=5]It's getting pretty late. Should probably get [b][color=PLUM][pulse color=SLATE_BLUE freq=0.2][font_size=36]some sleep[/font_size][/pulse][/color][/b] since I stayed all day long in bed, this headache does not want to go away, all I could do is read this book about [b][color=FOREST_GREEN][pulse color=YELLOW freq=0.2][font_size=36]Orcs[/font_size][/pulse][/color][/b] wanting to take over the world and some fellows fighting for the greater good... Couldn't even have a [b][color=CORAL][pulse color=ORANGE_RED freq=0.2][font_size=36]smoke[/font_size][/pulse][/color][/b] in this state."
